   "speakerIAST": "",
   "source": "IIT Kanpur Gita Supersite"
  },
  "3.35": {
   "speaker": "",
   "devanagari": [
    "श्रेयान्स्वधर्मो विगुणः परधर्मात्स्वनुष्ठितात् ।",
