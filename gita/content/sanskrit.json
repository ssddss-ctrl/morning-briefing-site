   "speakerIAST": "",
   "source": "IIT Kanpur Gita Supersite"
  },
  "3.21": {
   "speaker": "",
   "devanagari": [
    "यद्यदाचरति श्रेष्ठस्तत्तदेवेतरो जनः ।",
